# Copy to .env.local and fill in. Validated with zod at startup (src/lib/env.ts).

# Postgres connection URL. Neon: use the pooled connection string (host contains "-pooler").
# Local: postgres://bank:bank@localhost:5432/bank
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Auth.js session encryption key, 32+ characters. Generate one with: npx auth secret
AUTH_SECRET=replace-with-a-long-random-string-of-32-chars-or-more

# The demo account. These are shown on the sign-in page, so they are not secrets; keep them in
# env so a deployment can change the password without a code change. The email defaults to
# demo@bank-analytics.dev and must match the seeded customer (the seed reads the same variable).
# DEMO_USER_EMAIL=demo@bank-analytics.dev
DEMO_USER_PASSWORD=bank-demo-2026
